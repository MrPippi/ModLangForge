---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Icon } from './Icon';
import { ModIcon } from './ModIcon';
import { ModBanner } from './ModBanner';
import { BuiltinTag } from './BuiltinTag';
import type { BuiltinMod } from '@mlf/core/catalog';
import { modBanner, modDownloads, modIcon } from '../lib/data';
import { builtinDownloadLink } from '../lib/builtinDownload';
import { builtinPageDescription, builtinPageTitle, CHIP_CLASS, displayName, downloadsValue, formatDate, LOADER_LABELS } from '../lib/format';
import { sortVersions, versionRange } from '../islands/pickVersion';
import { t } from '../i18n/zh-TW';

interface Props {
  mod: BuiltinMod;
}

const { mod } = Astro.props;
const linkEntries = Object.entries(mod.links).filter((entry): entry is [string, string] => typeof entry[1] === 'string');
const LINK_LABELS: Record<string, string> = { modrinth: 'Modrinth', curseforge: 'CurseForge', source: '原始碼', homepage: '首頁' };
const versions = sortVersions(mod.mcVersions);
const banner = modBanner(mod.modId);
const downloads = modDownloads(mod.modId);
const download = builtinDownloadLink(mod.links);
const external = 'link inline-flex items-center gap-1';
---

<BaseLayout title={builtinPageTitle(mod)} description={builtinPageDescription(mod)}>
  <article data-pagefind-body>
    <nav aria-label={t.modPage.breadcrumb} class="mb-4 text-sm" data-pagefind-ignore>
      <ol class="flex flex-wrap items-center gap-1 text-muted">
        <li><a class="link inline-flex min-h-11 items-center" href="/mods/">{t.mods.title}</a></li>
        <li aria-hidden="true" class="px-1">/</li>
        <li aria-current="page" class="truncate text-fg">{mod.name}</li>
      </ol>
    </nav>

    <div class="grid items-start gap-8 lg:grid-cols-[minmax(0,1fr)_320px]">
      <header class="min-w-0">
        {banner && (
          <div class="h-36 overflow-hidden rounded-md border border-line bg-surface-2 sm:h-56">
            <ModBanner src={banner} name={mod.name} fallback="none" eager />
          </div>
        )}
        <div class:list={['flex gap-4', banner ? 'items-start px-4' : 'items-center']}>
          <ModIcon src={modIcon(mod.modId)} name={mod.name} size={64} className={banner ? 'relative z-10 -mt-8 ring-4 ring-surface' : ''} eager />
          <h1 class:list={['min-w-0 font-sans text-[1.75rem] leading-tight font-bold tracking-normal text-balance sm:text-[2.25rem]', banner && 'mt-2']} data-pagefind-meta="title">{displayName(mod)}</h1>
        </div>
        <p class="mt-3 max-w-[60ch] text-muted">{mod.summary}</p>
        <div class="mt-4 flex flex-wrap items-center gap-2">
          <BuiltinTag />
          {mod.loaders.map((l) => <span class={CHIP_CLASS}>{LOADER_LABELS[l]}</span>)}
          <span class={CHIP_CLASS}>Minecraft {versionRange(mod.mcVersions)}</span>
        </div>
        <p class="mt-3 text-hint">{t.modPage.updatedAt} {formatDate(mod.updatedAt)}</p>
        <div hidden data-pagefind-meta="modId">{mod.modId}</div>
        <div hidden data-pagefind-meta="builtin">true</div>
        <div hidden data-pagefind-meta="nameZh"></div>
        <div hidden>{mod.aliases.join(' ')}</div>

        <p class="mt-5 max-w-[65ch] rounded-sm border-l-4 border-info bg-info-soft p-3 text-sm text-fg">{t.builtin.note}</p>
        {download && (
          <p class="mt-5" data-pagefind-ignore>
            <a class="btn btn-primary inline-flex items-center gap-2" href={download.href} rel="noopener noreferrer" target="_blank">
              {t.builtin.getMod[download.platform]}<Icon name="external" size={12} /><span class="sr-only">{t.common.newWindow}</span>
            </a>
          </p>
        )}
      </header>

      <aside class="grid gap-6 text-sm" data-pagefind-ignore>
        <section aria-labelledby="info-title">
          <h2 id="info-title" class="mb-3 text-base">{t.modPage.infoTitle}</h2>
          <dl class="grid grid-cols-[auto_1fr] gap-x-4 gap-y-2.5 border-t-2 border-line pt-3">
            <dt class="text-muted">{t.modPage.authors}</dt><dd>{mod.authors.join('、')}</dd>
            {downloads !== null && (<><dt class="text-muted">{t.modPage.downloads[downloads.platform]}</dt><dd>{downloadsValue(downloads.count)}</dd></>)}
            <dt class="text-muted">{t.modPage.mcVersions}</dt><dd>{versions.join('、')}</dd>
            {linkEntries.length > 0 && (
              <>
                <dt class="text-muted">{t.modPage.links}</dt>
                <dd class="flex flex-wrap gap-x-3 gap-y-1">
                  {linkEntries.map(([kind, url]) => (
                    <a class={external} href={url} rel="noopener noreferrer" target="_blank">{LINK_LABELS[kind] ?? kind}<Icon name="external" size={10} /><span class="sr-only">{t.common.newWindow}</span></a>
                  ))}
                </dd>
              </>
            )}
          </dl>
        </section>
      </aside>
    </div>
  </article>
</BaseLayout>
