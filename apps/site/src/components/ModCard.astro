---
import type { ModSummary } from '../lib/data';
import { modUrl } from '../lib/config';
import ProgressBar from './ProgressBar.astro';
import StatusBadge from './StatusBadge.astro';

interface Props {
  mod: ModSummary;
}

const { mod } = Astro.props;
---

<a href={modUrl(mod.modId)} class="card flex flex-col gap-2 transition-shadow hover:shadow-md">
  <div class="flex items-start justify-between gap-2">
    <div class="min-w-0">
      <h3 class="truncate font-semibold">{mod.name}</h3>
      {mod.nameZh && <p class="truncate text-sm text-slate-500">{mod.nameZh}</p>}
    </div>
    <StatusBadge status={mod.status} />
  </div>
  <p class="line-clamp-2 text-sm text-slate-600 dark:text-slate-300">{mod.summary}</p>
  <p class="text-xs text-slate-500">{mod.mcVersions.join(' / ')}</p>
  <ProgressBar percent={mod.percent} />
</a>
