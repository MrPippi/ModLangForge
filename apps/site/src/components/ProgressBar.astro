---
import { formatPercent } from '../lib/format';

interface Props {
  percent: number;
  label?: string;
}

const { percent, label } = Astro.props;
---

<div class="flex items-center gap-2 text-xs text-slate-500">
  <div
    class="h-2 flex-1 overflow-hidden rounded bg-slate-200 dark:bg-slate-700"
    role="progressbar"
    aria-valuemin="0"
    aria-valuemax="100"
    aria-valuenow={percent}
    aria-label={label}
  >
    <div class="h-full bg-emerald-500" style={`width: ${formatPercent(percent)}`}></div>
  </div>
  <span class="w-10 text-right tabular-nums">{formatPercent(percent)}</span>
</div>
