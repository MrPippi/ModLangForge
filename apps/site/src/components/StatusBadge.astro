---
import type { TranslationStatus } from '@mlf/core/catalog';
import { STATUS_LABELS } from '../lib/format';

interface Props {
  status: TranslationStatus;
}

const { status } = Astro.props;
const colors: Record<TranslationStatus, string> = {
  machine: 'bg-amber-100 text-amber-800 dark:bg-amber-900 dark:text-amber-200',
  partial: 'bg-sky-100 text-sky-800 dark:bg-sky-900 dark:text-sky-200',
  reviewed: 'bg-emerald-100 text-emerald-800 dark:bg-emerald-900 dark:text-emerald-200',
};
---

<span class={`inline-block rounded-full px-2 py-0.5 text-xs font-medium ${colors[status]}`}>{STATUS_LABELS[status]}</span>
