---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Icon } from '../components/Icon';
import { ModIcon } from '../components/ModIcon';
import { ModBanner } from '../components/ModBanner';
import { ProgressLine } from '../components/ProgressLine';
import { GuideProgress } from '../components/GuideProgress';
import { StatusBadge } from '../components/StatusBadge';
import DownloadPanel from '../islands/DownloadPanel';
import SuggestDialog from '../islands/SuggestDialog';
import { modBanner, modDownloads, modIcon, type SiteMod } from '../lib/data';
import { contributorsUrl } from '../lib/config';
import { splitLatestCoverage, versionCoverage, type VersionCoverage } from '@mlf/core/catalog';
import { CHIP_CLASS, displayName, downloadsValue, formatDate, formatPercent, formatSourceVersion, LOADER_LABELS, modPageDescription, modPageTitle } from '../lib/format';
import { sortVersions, versionRange } from '../islands/pickVersion';
import { t } from '../i18n/zh-TW';

interface Props {
  mod: SiteMod;
}

const PREVIEW_LIMIT = 50;
const { mod } = Astro.props;
const { meta, stats } = mod;
const preview = Object.entries(mod.en).slice(0, PREVIEW_LIMIT);
const { latest: latestCoverage, older: olderCoverage } = splitLatestCoverage(versionCoverage(meta, mod.en, mod.zh));
const coverageLabel = (c: VersionCoverage): string => (c.nothingToTranslate ? t.modPage.versionSelfTranslated : formatPercent(c.percent));
const linkEntries = Object.entries(meta.links).filter((entry): entry is [string, string] => typeof entry[1] === 'string');
const LINK_LABELS: Record<string, string> = { modrinth: 'Modrinth', curseforge: 'CurseForge', source: '原始碼', homepage: '首頁' };
const versions = sortVersions(meta.mcVersions);
const banner = modBanner(meta.modId);
const downloads = modDownloads(meta.modId);
const external = 'link inline-flex items-center gap-1';
---

<BaseLayout title={modPageTitle(meta)} description={modPageDescription(meta, stats.percent)}>
  <article data-pagefind-body>
    <nav aria-label={t.modPage.breadcrumb} class="mb-4 text-sm" data-pagefind-ignore>
      <ol class="flex flex-wrap items-center gap-1 text-muted">
        <li><a class="link inline-flex min-h-11 items-center" href="/mods/">{t.mods.title}</a></li>
        <li aria-hidden="true" class="px-1">/</li>
        <li aria-current="page" class="truncate text-fg">{meta.name}</li>
      </ol>
    </nav>

    <div class="grid items-start gap-8 lg:grid-cols-[minmax(0,1fr)_380px]">
      <header class="min-w-0">
        {banner && (
          <div class="h-36 overflow-hidden rounded-md border border-line bg-surface-2 sm:h-56">
            <ModBanner src={banner} name={meta.name} fallback="none" eager />
          </div>
        )}
        <div class:list={['flex gap-4', banner ? 'items-start px-4' : 'items-center']}>
          <ModIcon src={modIcon(meta.modId)} name={meta.name} size={64} className={banner ? 'relative z-10 -mt-8 ring-4 ring-surface' : ''} eager />
          <h1 class:list={['min-w-0 font-sans text-[1.75rem] leading-tight font-bold tracking-normal text-balance sm:text-[2.25rem]', banner && 'mt-2']} data-pagefind-meta="title">{displayName(meta)}</h1>
        </div>
        <p class="mt-3 max-w-[60ch] text-muted">{meta.summary}</p>
        <div class="mt-4 flex flex-wrap items-center gap-2">
          <StatusBadge status={meta.translation.status} />
          {meta.loaders.map((l) => <span class={CHIP_CLASS}>{LOADER_LABELS[l]}</span>)}
          <span class={CHIP_CLASS}>Minecraft {versionRange(meta.mcVersions)}</span>
        </div>
        <p class="mt-3 text-hint">{t.modPage.updatedAt} {formatDate(meta.updatedAt)}</p>
        <div hidden data-pagefind-meta="modId">{meta.modId}</div>
        <div hidden data-pagefind-meta="percent">{stats.percent}</div>
        <div hidden data-pagefind-meta="nameZh">{meta.nameZh ?? ''}</div>
        <div hidden>{meta.aliases.join(' ')}</div>

        {meta.translation.builtinPercent !== undefined && (
          <p class="mt-5 max-w-[65ch] rounded-sm border-l-4 border-info bg-info-soft p-3 text-sm text-fg">{t.modPage.builtinNote(meta.translation.builtinPercent, stats.total)}</p>
        )}
        {meta.translation.status === 'machine' && (
          <p class="mt-5 max-w-[65ch] rounded-sm border-l-4 border-warn bg-warn-soft p-3 text-sm text-fg">{t.modPage.machineNote}</p>
        )}
      </header>

      <section class="card grid gap-4 p-5" aria-labelledby="download-title" data-pagefind-ignore>
        <h2 id="download-title" class="text-[1.375rem]">{t.modPage.downloadTitle}</h2>
        <div>
          <ProgressLine translated={stats.translated} total={stats.total} percent={stats.percent} detail={t.modPage.progress(stats.translated, stats.total)} label={t.common.progressLabel} />
          {stats.warnings > 0 && <p class="mt-2 text-xs text-warn">{t.modPage.warnings(stats.warnings)}</p>}
        </div>
        {mod.guideStats && <GuideProgress stats={mod.guideStats} />}
        <DownloadPanel client:visible modId={meta.modId} mcVersions={meta.mcVersions} />
        <details class="group border-t-2 border-line pt-3 text-sm">
          <summary class="flex min-h-11 cursor-pointer items-center justify-between font-medium marker:content-none">
            {t.modPage.installTitle}
            <Icon name="plus" size={12} className="text-muted transition-transform group-open:rotate-45" />
          </summary>
          <ol class="mt-1 list-decimal space-y-1 pl-5 text-muted">
            {t.modPage.installSteps.map((step) => <li>{step}</li>)}
          </ol>
        </details>
      </section>
    </div>

    <div class="mt-12 grid items-start gap-8 lg:grid-cols-[minmax(0,1fr)_320px]">
      <section class="min-w-0" aria-labelledby="preview-title" data-pagefind-ignore>
        <h2 id="preview-title" class="text-[1.375rem]">{t.modPage.preview}</h2>
        <p class="mt-1 mb-3 text-hint">{t.modPage.previewNote(preview.length, stats.total)}</p>
        <SuggestDialog client:idle modId={meta.modId} />
        <div class="card overflow-x-auto p-0">
          <table class="w-full text-left text-sm">
            <thead class="bg-surface-2">
              <tr><th scope="col" class="p-3 font-semibold">{t.modPage.original}</th><th scope="col" class="p-3 font-semibold">{t.modPage.translation}</th></tr>
            </thead>
            <tbody>
              {preview.map(([key, source]) => (
                <tr class="border-t-2 border-line">
                  <td class="p-3 align-top"><div>{source}</div><div class="mt-1 font-mono text-hint break-all" data-pagefind-ignore>{key}</div></td>
                  <td class="p-3 align-top">{mod.zh[key] ?? <span class="text-muted italic">{t.modPage.untranslated}</span>}<button type="button" class="link ml-2 text-xs" data-suggest-key={key} aria-label={t.suggest.openFor(key)}>{t.suggest.open}</button></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <aside class="grid gap-6 text-sm lg:sticky lg:top-24" data-pagefind-ignore>
        <section aria-labelledby="info-title">
          <h2 id="info-title" class="mb-3 text-base">{t.modPage.infoTitle}</h2>
          <dl class="grid grid-cols-[auto_1fr] gap-x-4 gap-y-2.5 border-t-2 border-line pt-3">
            <dt class="text-muted">{t.modPage.authors}</dt><dd>{meta.authors.join('、')}</dd>
            {downloads !== null && (<><dt class="text-muted">{t.modPage.downloads[downloads.platform]}</dt><dd>{downloadsValue(downloads.count)}</dd></>)}
            <dt class="text-muted">{t.modPage.mcVersions}</dt><dd>{versions.join('、')}</dd>
            <dt class="text-muted">{t.modPage.sourceVersions}</dt>
            <dd>
              <ul class="space-y-1">
                {latestCoverage.map((c) => <li>{formatSourceVersion(c.source)} <span class="text-muted tabular-nums">· {coverageLabel(c)}</span></li>)}
              </ul>
              {olderCoverage.length > 0 && (
                <details class="group mt-2">
                  <summary class="flex min-h-11 cursor-pointer items-center gap-2 text-muted marker:content-none hover:text-fg">
                    {t.modPage.olderSourceVersions(olderCoverage.length)}
                    <Icon name="plus" size={12} className="transition-transform group-open:rotate-45" />
                  </summary>
                  <ul class="space-y-1 text-muted">
                    {olderCoverage.map((c) => <li>{formatSourceVersion(c.source)} <span class="tabular-nums">· {coverageLabel(c)}</span></li>)}
                  </ul>
                </details>
              )}
            </dd>
            <dt class="text-muted">{t.modPage.license}</dt><dd>{meta.translation.license}</dd>
            <dt class="text-muted">{t.modPage.source}</dt>
            <dd>
              {meta.translation.source.url
                ? <a class={external} href={meta.translation.source.url} rel="noopener noreferrer" target="_blank">{meta.translation.source.name}<span class="sr-only">{t.common.newWindow}</span></a>
                : meta.translation.source.name}
            </dd>
            {meta.translation.contributors.length > 0 && (<><dt class="text-muted">{t.modPage.contributors}</dt><dd>{meta.translation.contributors.join('、')}</dd></>)}
            <dt class="text-muted">{t.modPage.community}</dt><dd><a class="link" href={contributorsUrl(meta.modId)}>{t.modPage.communityContributors}</a></dd>
            {linkEntries.length > 0 && (
              <>
                <dt class="text-muted">{t.modPage.links}</dt>
                <dd class="flex flex-wrap gap-x-3 gap-y-1">
                  {linkEntries.map(([kind, url]) => (
                    <a class={external} href={url} rel="noopener noreferrer" target="_blank">{LINK_LABELS[kind] ?? kind}<Icon name="external" size={10} /><span class="sr-only">{t.common.newWindow}</span></a>
                  ))}
                </dd>
              </>
            )}
          </dl>
        </section>
      </aside>
    </div>
  </article>
</BaseLayout>
