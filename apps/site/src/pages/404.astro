---
import BaseLayout from '../layouts/BaseLayout.astro';
import SearchBox from '../islands/SearchBox';
import { SITE_SHORT_NAME } from '../lib/config';
import { t } from '../i18n/zh-TW';
---

<BaseLayout title={`${t.notFound.title} | ${SITE_SHORT_NAME}`} description={t.notFound.body} noindex>
  <div class="mx-auto max-w-2xl py-16 text-center">
    <h1 class="text-2xl font-bold">{t.notFound.title}</h1>
    <p class="mt-2 mb-6 text-slate-500">{t.notFound.body}</p>
    <SearchBox client:load />
  </div>
</BaseLayout>
