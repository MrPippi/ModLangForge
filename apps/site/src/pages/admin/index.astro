---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdminApp from '../../admin/AdminApp';
import { s } from '../../admin/strings';
import { SITE_SHORT_NAME } from '../../lib/config';
---

<BaseLayout title={`${s.title} | ${SITE_SHORT_NAME}`} description={s.description} noindex>
  <h1 class="mb-4 text-2xl font-bold">{s.title}</h1>
  <AdminApp client:only="react" />
</BaseLayout>
