---
import BaseLayout from '../layouts/BaseLayout.astro';
import { ModCard } from '../components/ModCard';
import { PixelIcon } from '../components/PixelIcon';
import type { IconName } from '../components/pixelArt';
import SearchBox from '../islands/SearchBox';
import { byUpdatedDesc, getCatalog, toSummary } from '../lib/data';
import { SITE_NAME } from '../lib/config';
import { t } from '../i18n/zh-TW';

const HIGHLIGHT_COUNT = 6;
const STEP_ICONS: readonly IconName[] = ['search', 'download', 'upload'];
const catalog = await getCatalog();
const summaries = catalog.map(toSummary);
const totalEntries = catalog.reduce((sum, m) => sum + m.stats.translated, 0);
const recent = [...summaries].sort(byUpdatedDesc).slice(0, HIGHLIGHT_COUNT);
const complete = [...summaries].sort((a, b) => b.percent - a.percent || b.total - a.total).slice(0, HIGHLIGHT_COUNT);
---

<BaseLayout title={`${SITE_NAME}｜${t.site.tagline}`} description={t.site.description}>
  <section class="card -mt-2 overflow-hidden p-0">
    <div class="px-5 pt-10 pb-8 text-center sm:px-10">
      <h1 class="text-[1.375rem] leading-snug sm:text-[2.0625rem]">{t.site.tagline}</h1>
      <p class="mt-3 text-muted">{t.home.stats(catalog.length, totalEntries)}</p>
      <div class="mx-auto mt-6 max-w-2xl text-left">
        <SearchBox client:load />
      </div>
    </div>
    <div class="pixel-ground" aria-hidden="true"></div>
  </section>

  <section class="mt-10" aria-labelledby="steps-title">
    <h2 id="steps-title" class="sr-only">{t.home.stepsTitle}</h2>
    <ol class="grid gap-4 sm:grid-cols-3">
      {t.home.steps.map((step, i) => (
        <li class="flex gap-3 rounded-sm border-2 border-line bg-surface p-4">
          <span class="flex size-10 shrink-0 items-center justify-center rounded-sm bg-primary-soft text-link">
            <PixelIcon name={STEP_ICONS[i] ?? 'search'} size={20} />
          </span>
          <div>
            <h3 class="font-semibold">{step.title}</h3>
            <p class="mt-1 text-sm text-muted">{step.body}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <section class="mt-12" aria-labelledby="recent-title">
    <div class="mb-4 flex flex-wrap items-baseline justify-between gap-2">
      <h2 id="recent-title" class="text-[1.375rem]">{t.home.recent}</h2>
      <a class="link inline-flex min-h-11 items-center gap-1 text-sm" href="/mods/">
        {t.home.allMods}<PixelIcon name="arrowRight" size={14} />
      </a>
    </div>
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {recent.map((mod) => <ModCard mod={mod} />)}
    </div>
  </section>

  <section class="mt-12" aria-labelledby="complete-title">
    <h2 id="complete-title" class="mb-4 text-[1.375rem]">{t.home.complete}</h2>
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {complete.map((mod) => <ModCard mod={mod} />)}
    </div>
  </section>
</BaseLayout>
