---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { ModpackCard } from '../../components/ModpackCard';
import { getModpacks } from '../../lib/data';
import { byModpackName, toModpackSummary } from '../../lib/modpacks';
import { githubModpackRequestUrl, SITE_SHORT_NAME } from '../../lib/config';
import { t } from '../../i18n/zh-TW';

const packs = (await getModpacks()).map(toModpackSummary).sort(byModpackName);
---

<BaseLayout title={`${t.modpacks.title} | ${SITE_SHORT_NAME}`} description={t.modpacks.description}>
  <h1 class="text-[1.75rem] sm:text-[2.0625rem]">{t.modpacks.title}</h1>
  <p class="mt-2 mb-8 max-w-[60ch] text-muted">{t.modpacks.description}</p>
  {packs.length === 0 ? (
    <p class="text-muted">{t.modpacks.empty}</p>
  ) : (
    <>
      <p class="mb-3 text-sm text-muted">{t.modpacks.count(packs.length)}</p>
      <ul aria-label={t.modpacks.listLabel} class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {packs.map((pack) => <li><ModpackCard pack={pack} /></li>)}
      </ul>
    </>
  )}
  <p class="mt-8 text-sm">
    <a class="link inline-flex min-h-11 items-center" href={githubModpackRequestUrl()} rel="noopener noreferrer" target="_blank">{t.modpacks.request}<span class="sr-only">{t.common.newWindow}</span></a>
  </p>
</BaseLayout>
