---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProgressBar from '../../components/ProgressBar.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import DownloadPanel from '../../islands/DownloadPanel';
import SuggestDialog from '../../islands/SuggestDialog';
import { getCatalog, type SiteMod } from '../../lib/data';
import { githubEditUrl, githubIssueUrl, SUGGEST_ENABLED } from '../../lib/config';
import { versionCoverage } from '@mlf/core/catalog';
import { displayName, formatDate, formatPercent, formatSourceVersion, LOADER_LABELS, modPageDescription, modPageTitle } from '../../lib/format';
import { t } from '../../i18n/zh-TW';

export const getStaticPaths = (async () => {
  const catalog = await getCatalog();
  return catalog.map((mod) => ({ params: { modId: mod.meta.modId }, props: { mod } }));
}) satisfies GetStaticPaths;

interface Props {
  mod: SiteMod;
}

const PREVIEW_LIMIT = 50;
const { mod } = Astro.props;
const { meta, stats } = mod;
const preview = Object.entries(mod.en).slice(0, PREVIEW_LIMIT);
const coverage = versionCoverage(meta, mod.en, mod.zh);
const linkEntries = Object.entries(meta.links).filter((entry): entry is [string, string] => typeof entry[1] === 'string');
const LINK_LABELS: Record<string, string> = { modrinth: 'Modrinth', curseforge: 'CurseForge', source: '原始碼', homepage: '首頁' };
---

<BaseLayout title={modPageTitle(meta)} description={modPageDescription(meta, stats.percent)}>
  <article data-pagefind-body>
    <header class="flex flex-wrap items-start justify-between gap-4">
      <div>
        <h1 class="text-2xl font-bold" data-pagefind-meta="title">{displayName(meta)}</h1>
        <p class="mt-1 text-slate-600 dark:text-slate-300">{meta.summary}</p>
        <p class="mt-1 text-xs text-slate-400">modId：<code>{meta.modId}</code></p>
        <div hidden data-pagefind-meta="modId">{meta.modId}</div>
        <div hidden data-pagefind-meta="percent">{stats.percent}</div>
        <div hidden data-pagefind-meta="nameZh">{meta.nameZh ?? ''}</div>
        <div hidden>{meta.aliases.join(' ')}</div>
      </div>
      <StatusBadge status={meta.translation.status} />
    </header>

    {meta.translation.builtinPercent !== undefined && (
      <p class="mt-4 rounded-lg bg-sky-50 p-3 text-sm text-sky-800 dark:bg-sky-950 dark:text-sky-200">{t.modPage.builtinNote(meta.translation.builtinPercent, stats.total)}</p>
    )}

    {meta.translation.status === 'machine' && (
      <p class="mt-4 rounded-lg bg-amber-50 p-3 text-sm text-amber-800 dark:bg-amber-950 dark:text-amber-200">{t.modPage.machineNote}</p>
    )}

    <div class="mt-6 grid gap-6 lg:grid-cols-3">
      <section class="card lg:col-span-2" data-pagefind-ignore>
        <p class="mb-2 text-sm">{t.modPage.progress(stats.translated, stats.total)}</p>
        <ProgressBar percent={stats.percent} label={t.modPage.progress(stats.translated, stats.total)} />
        {stats.warnings > 0 && <p class="mt-2 text-xs text-amber-600">{t.modPage.warnings(stats.warnings)}</p>}
        <div class="mt-4">
          <DownloadPanel client:visible modId={meta.modId} mcVersions={meta.mcVersions} />
        </div>
        {!SUGGEST_ENABLED && (
          <div class="mt-4 flex flex-wrap gap-3 text-sm">
            <a class="link" href={githubEditUrl(meta.modId)} rel="noopener noreferrer" target="_blank">✏️ {t.modPage.edit}</a>
            <a class="link" href={githubIssueUrl(meta.modId)} rel="noopener noreferrer" target="_blank">🐞 {t.modPage.report}</a>
          </div>
        )}
      </section>

      <aside class="card text-sm" data-pagefind-ignore>
        <dl class="grid grid-cols-[auto_1fr] gap-x-3 gap-y-2">
          <dt class="text-slate-500">{t.modPage.authors}</dt><dd>{meta.authors.join('、')}</dd>
          <dt class="text-slate-500">{t.modPage.mcVersions}</dt><dd>{meta.mcVersions.join('、')}</dd>
          <dt class="text-slate-500">{t.modPage.loaders}</dt><dd>{meta.loaders.map((l) => LOADER_LABELS[l]).join('、')}</dd>
          <dt class="text-slate-500">{t.modPage.sourceVersions}</dt>
          <dd>
            <ul class="space-y-1">
              {coverage.map((c) => (
                <li>{formatSourceVersion(c.source)} <span class="text-slate-500">· {formatPercent(c.percent)}</span></li>
              ))}
            </ul>
          </dd>
          <dt class="text-slate-500">{t.modPage.updatedAt}</dt><dd>{formatDate(meta.updatedAt)}</dd>
          <dt class="text-slate-500">{t.modPage.license}</dt><dd>{meta.translation.license}</dd>
          <dt class="text-slate-500">{t.modPage.source}</dt>
          <dd>
            {meta.translation.source.url
              ? <a class="link" href={meta.translation.source.url} rel="noopener noreferrer" target="_blank">{meta.translation.source.name}</a>
              : meta.translation.source.name}
          </dd>
          {meta.translation.contributors.length > 0 && (<><dt class="text-slate-500">{t.modPage.contributors}</dt><dd>{meta.translation.contributors.join('、')}</dd></>)}
          <dt class="text-slate-500">{t.modPage.links}</dt>
          <dd class="flex flex-wrap gap-2">
            {linkEntries.map(([kind, url]) => (
              <a class="link" href={url} rel="noopener noreferrer" target="_blank">{LINK_LABELS[kind] ?? kind}</a>
            ))}
          </dd>
        </dl>
      </aside>
    </div>

    <section class="mt-8" data-pagefind-ignore>
      <h2 class="text-lg font-bold">{t.modPage.preview}</h2>
      <p class="mb-2 text-xs text-slate-500">{t.modPage.previewNote(preview.length, stats.total)}</p>
      {SUGGEST_ENABLED && <SuggestDialog client:idle modId={meta.modId} />}
      <div class="overflow-x-auto rounded-xl border border-slate-200 dark:border-slate-700">
        <table class="w-full text-left text-sm">
          <thead class="bg-slate-100 dark:bg-slate-800">
            <tr><th class="p-2">{t.modPage.original}</th><th class="p-2">{t.modPage.translation}</th></tr>
          </thead>
          <tbody>
            {preview.map(([key, source]) => (
              <tr class="border-t border-slate-200 dark:border-slate-700">
                <td class="p-2 align-top"><div>{source}</div><div class="text-xs text-slate-400" data-pagefind-ignore>{key}</div></td>
                <td class="p-2 align-top">{mod.zh[key] ?? <span class="text-slate-400">{t.modPage.untranslated}</span>}{SUGGEST_ENABLED && <button type="button" class="ml-2 text-xs link" data-suggest-key={key}>{t.suggest.open}</button>}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  </article>
</BaseLayout>
