---
import type { GetStaticPaths } from 'astro';
import type { BuiltinMod } from '@mlf/core/catalog';
import BuiltinModPage from '../../components/BuiltinModPage.astro';
import TranslatedModPage from '../../components/TranslatedModPage.astro';
import { getBuiltinMods, getCatalog, type SiteMod } from '../../lib/data';

export const getStaticPaths = (async () => {
  const [catalog, builtin] = await Promise.all([getCatalog(), getBuiltinMods()]);
  return [
    ...catalog.map((mod) => ({ params: { modId: mod.meta.modId }, props: { kind: 'translated' as const, mod } })),
    ...builtin.map((mod) => ({ params: { modId: mod.modId }, props: { kind: 'builtin' as const, mod } })),
  ];
}) satisfies GetStaticPaths;

type Props = { kind: 'translated'; mod: SiteMod } | { kind: 'builtin'; mod: BuiltinMod };

const props = Astro.props;
---

{props.kind === 'builtin' ? <BuiltinModPage mod={props.mod} /> : <TranslatedModPage mod={props.mod} />}
