---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Icon } from '../../components/Icon';
import { ProgressBar } from '../../components/ProgressBar';
import { StatusBadge } from '../../components/StatusBadge';
import DownloadPanel from '../../islands/DownloadPanel';
import { getCatalog, type SiteMod } from '../../lib/data';
import { githubEditUrl, githubIssueUrl } from '../../lib/config';
import { versionCoverage } from '@mlf/core/catalog';
import { displayName, formatDate, formatPercent, formatSourceVersion, LOADER_LABELS, modPageDescription, modPageTitle } from '../../lib/format';
import { t } from '../../i18n/zh-TW';

export const getStaticPaths = (async () => {
  const catalog = await getCatalog();
  return catalog.map((mod) => ({ params: { modId: mod.meta.modId }, props: { mod } }));
}) satisfies GetStaticPaths;

interface Props {
  mod: SiteMod;
}

const PREVIEW_LIMIT = 50;
const { mod } = Astro.props;
const { meta, stats } = mod;
const preview = Object.entries(mod.en).slice(0, PREVIEW_LIMIT);
const coverage = versionCoverage(meta, mod.en, mod.zh);
const linkEntries = Object.entries(meta.links).filter((entry): entry is [string, string] => typeof entry[1] === 'string');
const LINK_LABELS: Record<string, string> = { modrinth: 'Modrinth', curseforge: 'CurseForge', source: '原始碼', homepage: '首頁' };
---

<BaseLayout title={modPageTitle(meta)} description={modPageDescription(meta, stats.percent)}>
  <article data-pagefind-body>
    <header class="card flex flex-wrap items-start justify-between gap-4 p-5 sm:p-6">
      <div class="min-w-0">
        <h1 class="font-sans text-2xl font-bold tracking-normal" data-pagefind-meta="title">{displayName(meta)}</h1>
        <p class="mt-2 text-muted">{meta.summary}</p>
        <p class="mt-2 text-hint">modId：<code class="font-mono">{meta.modId}</code></p>
        <div hidden data-pagefind-meta="modId">{meta.modId}</div>
        <div hidden data-pagefind-meta="percent">{stats.percent}</div>
        <div hidden data-pagefind-meta="nameZh">{meta.nameZh ?? ''}</div>
        <div hidden>{meta.aliases.join(' ')}</div>
      </div>
      <StatusBadge status={meta.translation.status} />
    </header>

    {meta.translation.builtinPercent !== undefined && (
      <p class="mt-4 rounded-sm border-l-4 border-info bg-info-soft p-3 text-sm text-fg">{t.modPage.builtinNote(meta.translation.builtinPercent, stats.total)}</p>
    )}

    {meta.translation.status === 'machine' && (
      <p class="mt-4 rounded-sm border-l-4 border-warn bg-warn-soft p-3 text-sm text-fg">{t.modPage.machineNote}</p>
    )}

    <div class="mt-6 grid gap-6 lg:grid-cols-3">
      <section class="card lg:col-span-2" data-pagefind-ignore>
        <p class="mb-2 text-sm font-medium">{t.modPage.progress(stats.translated, stats.total)}</p>
        <ProgressBar percent={stats.percent} label={t.modPage.progress(stats.translated, stats.total)} />
        {stats.warnings > 0 && <p class="mt-2 text-xs text-warn">{t.modPage.warnings(stats.warnings)}</p>}
        <div class="mt-4">
          <DownloadPanel client:visible modId={meta.modId} mcVersions={meta.mcVersions} />
        </div>
        <div class="mt-5 flex flex-wrap gap-x-4 border-t-2 border-line pt-3 text-sm">
          <a class="link inline-flex min-h-11 items-center gap-1.5" href={githubEditUrl(meta.modId)} rel="noopener noreferrer" target="_blank"><Icon name="edit" size={14} />{t.modPage.edit}<span class="sr-only">{t.common.newWindow}</span></a>
          <a class="link inline-flex min-h-11 items-center gap-1.5" href={githubIssueUrl(meta.modId)} rel="noopener noreferrer" target="_blank"><Icon name="bug" size={14} />{t.modPage.report}<span class="sr-only">{t.common.newWindow}</span></a>
        </div>
      </section>

      <aside class="card text-sm" data-pagefind-ignore>
        <dl class="grid grid-cols-[auto_1fr] gap-x-3 gap-y-2">
          <dt class="text-muted">{t.modPage.authors}</dt><dd>{meta.authors.join('、')}</dd>
          <dt class="text-muted">{t.modPage.mcVersions}</dt><dd>{meta.mcVersions.join('、')}</dd>
          <dt class="text-muted">{t.modPage.loaders}</dt><dd>{meta.loaders.map((l) => LOADER_LABELS[l]).join('、')}</dd>
          <dt class="text-muted">{t.modPage.sourceVersions}</dt>
          <dd>
            <ul class="space-y-1">
              {coverage.map((c) => (
                <li>{formatSourceVersion(c.source)} <span class="text-muted">· {formatPercent(c.percent)}</span></li>
              ))}
            </ul>
          </dd>
          <dt class="text-muted">{t.modPage.updatedAt}</dt><dd>{formatDate(meta.updatedAt)}</dd>
          <dt class="text-muted">{t.modPage.license}</dt><dd>{meta.translation.license}</dd>
          <dt class="text-muted">{t.modPage.source}</dt>
          <dd>
            {meta.translation.source.url
              ? <a class="link" href={meta.translation.source.url} rel="noopener noreferrer" target="_blank">{meta.translation.source.name}</a>
              : meta.translation.source.name}
          </dd>
          {meta.translation.contributors.length > 0 && (<><dt class="text-muted">{t.modPage.contributors}</dt><dd>{meta.translation.contributors.join('、')}</dd></>)}
          <dt class="text-muted">{t.modPage.links}</dt>
          <dd class="flex flex-wrap gap-2">
            {linkEntries.map(([kind, url]) => (
              <a class="link" href={url} rel="noopener noreferrer" target="_blank">{LINK_LABELS[kind] ?? kind}</a>
            ))}
          </dd>
        </dl>
      </aside>
    </div>

    <section class="mt-8" data-pagefind-ignore>
      <h2 class="text-[1.375rem]">{t.modPage.preview}</h2>
      <p class="mt-1 mb-3 text-hint">{t.modPage.previewNote(preview.length, stats.total)}</p>
      <div class="card overflow-x-auto p-0">
        <table class="w-full text-left text-sm">
          <thead class="bg-surface-2">
            <tr><th scope="col" class="p-3 font-semibold">{t.modPage.original}</th><th scope="col" class="p-3 font-semibold">{t.modPage.translation}</th></tr>
          </thead>
          <tbody>
            {preview.map(([key, source]) => (
              <tr class="border-t-2 border-line">
                <td class="p-3 align-top"><div>{source}</div><div class="mt-1 font-mono text-hint break-all" data-pagefind-ignore>{key}</div></td>
                <td class="p-3 align-top">{mod.zh[key] ?? <span class="text-muted italic">{t.modPage.untranslated}</span>}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  </article>
</BaseLayout>
