---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { BuiltinTag } from '../../components/BuiltinTag';
import { StatusBadge } from '../../components/StatusBadge';
import ModsBrowser from '../../islands/ModsBrowser';
import { sortMods } from '../../islands/filterMods';
import { getAllSummaries } from '../../lib/data';
import { INITIAL_COUNT, SUMMARY_STATUSES } from '../../lib/summary';
import { SITE_SHORT_NAME } from '../../lib/config';
import { t } from '../../i18n/zh-TW';

const all = sortMods(await getAllSummaries(), 'name');
const initial = all.slice(0, INITIAL_COUNT);
---

<BaseLayout title={`${t.mods.title} | ${SITE_SHORT_NAME}`} description={t.mods.description}>
  <div class="mb-8 grid gap-6 lg:grid-cols-[minmax(0,1fr)_auto] lg:items-end">
    <div>
      <h1 class="text-[1.75rem] sm:text-[2.0625rem]">{t.mods.title}</h1>
      <p class="mt-2 max-w-[60ch] text-muted">{t.mods.description}</p>
    </div>
    <dl aria-label={t.mods.legendLabel} class="grid gap-2 text-sm sm:grid-cols-3 lg:grid-cols-1">
      {SUMMARY_STATUSES.map((s) => (
        <div class="flex items-center gap-2">
          <dt>{s === 'builtin' ? <BuiltinTag /> : <StatusBadge status={s} />}</dt>
          <dd class="text-xs text-muted">{t.mods.legend[s]}</dd>
        </div>
      ))}
    </dl>
  </div>
  <noscript><p class="mb-4 text-sm text-muted">{t.mods.noscript}</p></noscript>
  <ModsBrowser client:load initial={initial} total={all.length} />
</BaseLayout>
