---
import BaseLayout from '../layouts/BaseLayout.astro';
import PackPage from '../islands/PackPage';
import { SITE_SHORT_NAME } from '../lib/config';
import { t } from '../i18n/zh-TW';
---

<BaseLayout title={`${t.pack.title} | ${SITE_SHORT_NAME}`} description={t.pack.description} noindex>
  <h1 class="text-2xl font-bold">{t.pack.title}</h1>
  <p class="mt-1 mb-4 text-slate-500">{t.pack.description}</p>
  <PackPage client:only="react" />
</BaseLayout>
