---
import BaseLayout from '../layouts/BaseLayout.astro';
import TranslatorApp from '../translator/TranslatorApp';
import { SITE_SHORT_NAME } from '../lib/config';

const description = '把 Minecraft 模組檔（.jar）拖進網頁就能翻譯，做成繁體中文資源包，或分享給本站。';
---

<BaseLayout title={`自己翻譯模組 | ${SITE_SHORT_NAME}`} description={description}>
  <TranslatorApp client:only="react" />
</BaseLayout>
