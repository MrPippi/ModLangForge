{
  "name": "modlangforge",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npm run dev -w apps/site",
    "build": "npm run build -w apps/site",
    "dev:worker": "wrangler dev --local-upstream localhost:8787",
    "test:worker": "npm test -w @mlf/worker",
    "lint": "eslint .",
    "test": "npm test --workspaces --if-present",
    "validate:data": "tsx scripts/validate-data.ts",
    "check:dist": "tsx scripts/check-dist-files.ts",
    "test:e2e": "playwright test",
    "fetch:modrinth": "tsx scripts/fetch-modrinth.ts",
    "backfill:curseforge": "tsx scripts/backfill-curseforge.ts",
    "migrate:source-versions": "tsx scripts/migrate-source-versions.ts",
    "add:version": "tsx scripts/add-source-version.ts",
    "add:modpack": "tsx scripts/add-modpack.ts",
    "track:versions": "tsx scripts/track-versions.ts",
    "glossary:mine": "tsx scripts/mine-glossary.ts",
    "subset:font": "tsx scripts/subset-pixel-font.ts",
    "brand:build": "tsx scripts/build-brand.ts",
    "icons:fetch": "tsx scripts/fetch-mod-icons.ts",
    "stats:fetch": "tsx scripts/fetch-mod-stats.ts",
    "banners:fetch": "tsx scripts/fetch-mod-banners.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.4",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "yaml": "^2.9.1"
  },
  "overrides": {
    "miniflare": {
      "sharp": "$sharp"
    }
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=24"
  }
}
