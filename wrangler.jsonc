{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "modlangforge",
  "main": "apps/worker/src/index.ts",
  "compatibility_date": "2026-09-30",
  "assets": {
    "directory": "apps/site/dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/api/v1/auth/*",
      "/api/v1/suggestions",
      "/api/v1/suggestions/*",
      "/api/v1/me",
      "/api/v1/me/*",
      "/api/v1/admin/*",
      "/api/v1/contributors",
      "/api/v1/contributors/*",
      "/contributors/*"
    ]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "modlangforge", "database_id": "fad76eba-4f80-4439-bf81-9eb1d2012870", "migrations_dir": "migrations" }
  ],
  // 正式網址（Origin 檢查、OAuth callback、Turnstile hostname 都以此為準）；本機 wrangler dev 由 .dev.vars 覆寫為 localhost
  "vars": {
    "SITE_URL": "https://modlangforge.com",
    "ADMIN_BOOTSTRAP": "github:MrPippi",
    "GITHUB_API_BASE": "https://api.github.com",
    "REPO": "MrPippi/ModLangForge",
    // Mojang（api.mojang.com / api.minecraftservices.com）對 Cloudflare Workers 出口回 403；
    // 改走 playerdb.co（代理 Mojang）。只送出玩家名稱，不帶其他使用者資料。
    "MOJANG_API_BASE": "https://playerdb.co"
  },
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true }
}
