{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "modlangforge",
  "main": "apps/worker/src/index.ts",
  "compatibility_date": "2026-09-30",
  "assets": {
    "directory": "apps/site/dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/api/v1/auth/*",
      "/api/v1/suggestions",
      "/api/v1/suggestions/*",
      "/api/v1/me",
      "/api/v1/me/*",
      "/api/v1/admin/*"
    ]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "modlangforge", "database_id": "fad76eba-4f80-4439-bf81-9eb1d2012870", "migrations_dir": "migrations" }
  ],
  // 正式網址；本機 wrangler dev 由 .dev.vars 覆寫為 localhost
  "vars": { "SITE_URL": "https://modlangforge.jack3555tw.workers.dev" },
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true }
}
